APP_ENV=development
DEBUG=true

# Data provider: 'mock' (default offline), 'eodhd', or 'lseg'
DATA_PROVIDER=mock
VENDOR_API_KEY=
VENDOR_BASE_URL=

# PostgreSQL Database Connection URL format:
# postgresql://<username>:<password>@<host>:<port>/<database_name>
# Example: postgresql://postgres:postgres@localhost:5432/screening_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/screening_db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
